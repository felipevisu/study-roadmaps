---
import '../styles/global.css'

interface Props {
  title: string
  accent?: string
  /** shown on the right of the top bar */
  status?: string
}

const { title, accent, status } = Astro.props
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="data:," />
  </head>
  <body style={accent ? `--accent: ${accent}` : undefined}>
    <header class="site-head">
      <div class="wrap">
        <a href="/">Study-Plan</a>
        {status && <span class="head-right">{status}</span>}
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">Markdown in, HTML out — um arquivo por semana</div>
    </footer>
  </body>
</html>
