---
import { stats, type Week } from '../lib/data'

interface Props {
  weeks: Week[]
  /** hide the numbers under the cells */
  bare?: boolean
}

const { weeks, bare = false } = Astro.props
const s = stats(weeks)
---

<div class="gauge">
  <div
    class="gauge-cells"
    role="progressbar"
    aria-valuenow={s.percent}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-label={`${s.percent}% concluído, ${s.done} de ${s.total} semanas`}
  >
    {weeks.map((w) => <span data-s={w.data.status} title={`Semana ${w.data.week}`} />)}
  </div>

  {
    !bare && (
      <div class="gauge-legend">
        <span>
          <b>{s.done}</b>/{s.total} semanas
        </span>
        {s.doing > 0 && (
          <span>
            <b>{s.doing}</b> em andamento
          </span>
        )}
        {s.skipped > 0 && (
          <span>
            <b>{s.skipped}</b> pulada{s.skipped > 1 ? 's' : ''}
          </span>
        )}
        <span>
          <b>{s.pocs}</b> POCs
        </span>
      </div>
    )
  }
</div>
