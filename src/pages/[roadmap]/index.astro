---
import { render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import Progress from '../../components/Progress.astro'
import WeekList from '../../components/WeekList.astro'
import { allRoadmaps, weeksOf, stats } from '../../lib/data'

export async function getStaticPaths() {
  const roadmaps = await allRoadmaps()
  return roadmaps.map((roadmap) => ({
    params: { roadmap: roadmap.id },
    props: { roadmap },
  }))
}

const { roadmap } = Astro.props
const weeks = await weeksOf(roadmap.id)
const s = stats(weeks)
const { Content } = await render(roadmap)

const next =
  weeks.find((w) => w.data.status === 'doing') ?? weeks.find((w) => w.data.status === 'todo')
---

<Base
  title={`${roadmap.data.title} — Study-Plan`}
  accent={roadmap.data.accent}
  status={`Roadmap / ${roadmap.id} — ${s.percent}%`}
>
  <div class="wrap">
    <section class="hero">
      <p class="kicker">
        <span>{roadmap.data.subtitle}</span>
        <span>{s.percent}% concluído</span>
      </p>
      <h1 class="mono-huge">{roadmap.data.title}</h1>

      <Progress weeks={weeks} />

      {
        next && (
          <p class="hero-sub" style="margin-top: 1.5rem">
            Próxima: <b>{String(next.data.week).padStart(2, '0')} {next.data.title}</b>
          </p>
        )
      }
    </section>

    <section>
      <WeekList roadmap={roadmap.id} weeks={weeks} />
    </section>

    <section class="section">
      <h2>Regras e referências</h2>
      <div class="prose">
        <Content />
      </div>
    </section>
  </div>
</Base>
