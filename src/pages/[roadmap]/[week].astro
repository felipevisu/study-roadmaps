---
import { render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { allRoadmaps, weeksOf, weekSlug, STATUS } from '../../lib/data'

export async function getStaticPaths() {
  const roadmaps = await allRoadmaps()
  const paths = []

  for (const roadmap of roadmaps) {
    const weeks = await weeksOf(roadmap.id)
    weeks.forEach((week, i) => {
      paths.push({
        params: { roadmap: roadmap.id, week: weekSlug(week) },
        props: { roadmap, week, prev: weeks[i - 1], next: weeks[i + 1], total: weeks.length },
      })
    })
  }
  return paths
}

const { roadmap, week, prev, next, total } = Astro.props
const { Content } = await render(week)
const status = STATUS[week.data.status]
const nn = (n: number) => String(n).padStart(2, '0')
const fmt = new Intl.DateTimeFormat('pt-BR', { dateStyle: 'long' })
---

<Base
  title={`Semana ${week.data.week}: ${week.data.title} — ${roadmap.data.title}`}
  accent={roadmap.data.accent}
  status={`${roadmap.id} / semana ${nn(week.data.week)}`}
>
  <div class="wrap">
    <header class="week-head">
      <div>
        <p class="kicker">
          <span>{week.data.phase ?? roadmap.data.title}</span>
        </p>
        <h1 class="week-h1">{week.data.title}</h1>
        <p class={`badge ${status.className}`}>
          {status.label}
          {week.data.done_at && ` · ${fmt.format(week.data.done_at)}`}
        </p>
      </div>
      <div class="n" aria-label={`Semana ${week.data.week} de ${total}`}>{nn(week.data.week)}</div>
    </header>

    <hr class="rule-double" />

    <div class="section" style="border-top: 0; padding-top: 2rem">
      <article class="prose">
        <Content />
      </article>
    </div>

    <section class="section">
      <h2>POCs</h2>
      {
        week.data.pocs.length === 0 ? (
          <p class="empty">Nada publicado nesta semana ainda</p>
        ) : (
          <ul class="pocs">
            {week.data.pocs.map((p) => (
              <li>{p.url ? <a href={p.url}>{p.label}</a> : <span>{p.label}</span>}</li>
            ))}
          </ul>
        )
      }
    </section>

    <nav class="pager">
      {
        prev ? (
          <a href={`/${roadmap.id}/${weekSlug(prev)}/`}>
            <em>← Semana {nn(prev.data.week)}</em>
            {prev.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={`/${roadmap.id}/${weekSlug(next)}/`}>
            <em>Semana {nn(next.data.week)} →</em>
            {next.data.title}
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </div>
</Base>
